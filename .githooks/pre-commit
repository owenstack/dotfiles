#!/usr/bin/env bash
set -euo pipefail
root=$(git rev-parse --show-toplevel)
cd "$root"
if command -v gitleaks >/dev/null 2>&1; then gitleaks protect --staged --redact; else
  echo 'gitleaks is required for pre-commit. Install it with: sudo pacman -S gitleaks' >&2
  echo 'Emergency escape hatch: git commit --no-verify (use only after an equivalent secret scan).' >&2
  exit 1
fi
./scripts/check.sh
