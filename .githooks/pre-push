#!/usr/bin/env bash
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo 'gitleaks is required for pre-push. Install it with: sudo pacman -S gitleaks' >&2
  echo 'Emergency escape hatch: git push --no-verify (use only after an equivalent secret scan).' >&2
  exit 1
fi
exec "$(git rev-parse --show-toplevel)/scripts/check.sh"
